%% Task 5 - Sinusoidal waveform 

% Sinusoidal creation givn by the guide
samples=[0: 1E5-1];
x_sine=sin(0.22*samples);

bits_sine = 2:14;         
snr_sine = zeros(size(bits_sine));

corr_sine = zeros(size(bits_sine)); % ii)

Px_sine = mean(x_sine.^2);

for i = 1:length(bits_sine)

    N = bits_sine(i);
    levels = 2^N; 

    xq = round((x_sine + 1) * (levels - 1) / 2); % Normalize from [-1, 1] to [0, L-1] and then round
    x_quant = (xq / (levels - 1)) * 2 - 1;       % Rescale back to [-1, 1]
    
    err_sine = x_quant - x_sine;

    % i)
    Pn_sine = mean(err_sine.^2);
    snr_sine(i) = 10 * log10(Px_sine / Pn_sine);

    % ii)
    res_corr = corrcoef(x_sine,err_sine); % Crossed Correlation 
    corr_sine(i) = abs(res_corr(1,2));
    % corr_sine(i) = abs(res_corr(2,1));

    %   Selecting the X value, res_corr(2,1) would also work
    %
    %   1 2       
    % [ 1 X ] 1
    % [ X 1 ] 2

end

p_sine = polyfit(bits_sine, snr_sine, 1); % First order fit
snr_sine_aprox = polyval(p_sine, bits_sine); 

fprintf('\nModelo SNR Sinusoide: SNR = %.2f * N + (%.2f)\n', p_sine(1), p_sine(2));

% ii) Correlation Graphic
figure('Name', 'Task 5.ii - Correlation');
stem(bits_sine, corr_sine, 'filled', 'LineWidth', 1.5);
grid on;
xlabel('Number of bits (N)');
ylabel('|Correlation Coefficients|');
title('Correlation between Sinusoidal and Quantization Error');

% iii) PDF evolution

figure('Name', 'Task 5.iii - PDF evolution');

% PDF's Original Sinusoidal
subplot(2,1,1);
x_pdf = x_sine; 
[H, X] = hist(x_pdf, 50); equalize = 50/(max(x_pdf)-min(x_pdf));
bar(X, H/sum(H)*equalize, 0.5, 'FaceColor', [0.2 0.6 0.8]);
ylabel('PDF'); xlabel('x[n] amplitude');
title('PDFs Original Sinusoidal (U shaped distribution)');

% PDF's Quantization error (N=14 bits - último do loop)
subplot(2,1,2);
x_pdf = err_sine; 
[H, X] = hist(x_pdf, 50); equalize = 50/(max(x_pdf)-min(x_pdf));
bar(X, H/sum(H)*equalize, 0.5, 'FaceColor', [0.8 0.2 0.2]);
ylabel('PDF'); xlabel('Erro amplitude');
title('PDFs Quantization Error (N=14 bits - Uniform)');


% We need to explain 5.iii)


%% Task 6 -

factors = [2, 4];

% Audio implementation
for F = factors
    % A. Decimation: Keep every F-th sample
    x_decimated = downsample(x, F);
    
    % B. Upsampling: Insert F-1 zeros between samples
    x_zeros = upsample(x_decimated, F);
    
    % C. Repetition: Use filter to replace zeros with previous sample
    % The filter 'ones(1, F)' sums the current and F-1 previous samples.
    % Since only one sample in every F is non-zero, this effectively repeats it.
    b = ones(1, F);
    a = 1;
    x_reconstructed = filter(b, a, x_zeros);
    
    % Visualization
    figure('Name', ['Audio Decimation F=' num2str(F)]);
    subplot(2,1,1); plot(x(1:1000)); title('Original');
    subplot(2,1,2); plot(x_reconstructed(1:1000)); title(['Reconstructed (F=' num2str(F) ')']);
    
    % Play result
    % sound(x_reconstructed, FS); pause(length(x_reconstructed)/FS + 1);
end

for F = factors
    % A. Decimation: Downsample both rows and columns
    A_decimated = A(1:F:end, 1:F:end);
    
    % B. Upsampling: Create a grid of zeros and place decimated pixels
    [orig_h, orig_w] = size(A);
    A_zeros = zeros(orig_h, orig_w);
    A_zeros(1:F:end, 1:F:end) = A_decimated;
    
    % C. Repetition: Use filter2 with an FxF mask of ones
    % This replicates each pixel into an FxF block
    h = ones(F, F);
    A_reconstructed = filter2(h, A_zeros);
    
    % Visualization
    figure('Name', ['Image Decimation F=' num2str(F)]);
    imshow(A_reconstructed);
    title(['Decimated/Repeated Lena (F=' num2str(F) ')']);
end

clear; % Just to avoid spamming



